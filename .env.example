# croccante — stream key configuration
# Copy this file to .env on the server and fill in real values.
# NEVER commit .env to git.

# YouTube stream key (Settings → Live → Stream key)
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Twitch stream key (Dashboard → Settings → Stream → Primary Stream key)
TWITCH_STREAM_KEY=live_000000000_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facebook stream key (Live Producer → Go live → Stream key)
# Full key including the "FB-" prefix if present
FACEBOOK_STREAM_KEY=FB-0000000000000000-0-Abxxxxxxxxxxxxxxxx
