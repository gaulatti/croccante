# croccante — destination configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Destinations are a flat, generic list of FULL URLs: RELAY_DEST_1 … RELAY_DEST_20.
# Any URL ffmpeg can write FLV to works — rtmp://, rtmps://, or a local sink.
# Empty and absent slots are skipped. Slots do NOT need to be contiguous:
# defining only RELAY_DEST_1 and RELAY_DEST_7 is valid.
#
# The container refuses to start when no destination is configured.

# One runtime controls one Alcantara program. Required.
PROGRAM_ID=replace-with-alcantara-program-id

# The control token is mounted as a file; never put it in this environment
# file. This is the default in the production and test commands.
CONTROL_TOKEN_FILE=/run/secrets/croccante-control-token

# ── YouTube ───────────────────────────────────────────────────────────────────
# Plain RTMP ingest:
RELAY_DEST_1=rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx
# ...or RTMPS ingest on 443, useful on networks that block 1935:
# RELAY_DEST_1=rtmps://a.rtmps.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx

# ── A local or self-hosted RTMP sink ──────────────────────────────────────────
# RELAY_DEST_2=rtmp://10.0.0.5:1935/live/mystream

# ── Twitch ────────────────────────────────────────────────────────────────────
# RELAY_DEST_3=rtmp://live.twitch.tv/app/live_000000000_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Facebook ──────────────────────────────────────────────────────────────────
# Facebook requires RTMPS. ffmpeg speaks it natively — no stunnel involved.
# RELAY_DEST_4=rtmps://live-api-s.facebook.com:443/rtmp/FB-000000000000000-0-Abxx

# ── Durable filler store ──────────────────────────────────────────────────────
# Production mounts /opt/croccante/fillers here. Profiles and signed source
# requests arrive only through the authenticated Alana control API.
# FILLER_STORE_DIR=/var/lib/croccante/fillers

# ── Tuning (optional) ─────────────────────────────────────────────────────────
# Highest RELAY_DEST_n slot number scanned. Default 20.
# RELAY_MAX_SLOTS=20
#
# Socket read/write timeout for relay ffmpeg processes, in microseconds.
# Default 10000000 (10s).
# RELAY_RW_TIMEOUT=10000000
#
# Retry backoff ceiling in seconds. Default 30.
# RELAY_BACKOFF_MAX=30
#
# RTMP application name the program publisher uses. Default "live".
# RTMP_APP=live
#
# Private lifecycle listener. Keep this on an internal Docker network; do not
# publish it on a public interface. Defaults: 0.0.0.0:8081.
# CONTROL_BIND=0.0.0.0
# CONTROL_PORT=8081
