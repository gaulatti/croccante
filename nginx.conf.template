load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

worker_processes auto;
error_log  /var/log/nginx/error.log warn;
pid        /run/nginx.pid;

events {
    worker_connections 1024;
}

# No HTTP block needed — pure relay, no HLS/DASH output
rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        # OBS connects to rtmp://<server-ip>:1935/live/<any-stream-key>
        application live {
            live on;
            record off;

            # ── YouTube ──────────────────────────────────────────────────────
            push rtmp://a.rtmp.youtube.com/live2/${YOUTUBE_STREAM_KEY};

            # ── Twitch ───────────────────────────────────────────────────────
            push rtmp://live.twitch.tv/app/${TWITCH_STREAM_KEY};

            # ── Facebook (RTMPS via local stunnel proxy on port 19350) ───────
            # stunnel terminates TLS and forwards to live-api-s.facebook.com:443
            push rtmp://127.0.0.1:19350/rtmp/${FACEBOOK_STREAM_KEY};
        }
    }
}
